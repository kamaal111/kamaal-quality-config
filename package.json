{
  "name": "@kamaal111/kamaal-quality-config",
  "version": "0.0.1",
  "description": "Kamaal Farah's shared oxlint quality config.",
  "keywords": [
    "lint",
    "oxlint",
    "oxlint-config",
    "quality"
  ],
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamaal111/kamaal-quality-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/generate-json-config.ts",
    "clean:build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "release": "node ./scripts/publish.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@kamaal111/oxlint-plugin-anti-slop": "^0.0.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
