{
  "name": "@kamaal111/kamaal-quality-config",
  "version": "0.0.1",
  "description": "Kamaal Farah's shared quality configurations.",
  "keywords": [
    "lint",
    "oxlint",
    "oxlint-config",
    "quality"
  ],
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamaal111/kamaal-quality-config.git"
  },
  "bin": {
    "kqc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "swift-format.json",
    "swift/SwiftLintChecks/Package.swift",
    "swift/SwiftLintChecks/Package.resolved",
    "swift/SwiftLintChecks/Sources",
    "swift/SwiftLintChecks/Tests"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./plugins/consistent-inline-type-imports": "./dist/plugins/consistent-inline-type-imports.js",
    "./plugins/no-nullish-check-first-ternary": "./dist/plugins/no-nullish-check-first-ternary.js",
    "./plugins/prefer-nullish": "./dist/plugins/prefer-nullish.js",
    "./plugins/prefer-while-true": "./dist/plugins/prefer-while-true.js",
    "./swift-format": {
      "types": "./dist/swift-format.d.ts",
      "default": "./dist/swift-format.js"
    },
    "./swift-format.json": "./swift-format.json",
    "./plugins/anti-slop": "./dist/plugins/anti-slop.js",
    "./plugins/stylistic": "./dist/plugins/stylistic.js",
    "./plugins/import": "./dist/plugins/import.js",
    "./plugins/require-multiline-arrow-braces": "./dist/plugins/require-multiline-arrow-braces.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/generate-json-config.ts",
    "clean:build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "lint": "pnpm run build && oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run type-check",
    "test": "pnpm run build && tsc -p tsconfig.tests.json && vitest run",
    "release": "node ./scripts/publish.ts",
    "prepare": "husky",
    "test:swift-format": "SWIFT_FORMAT_TEST=1 pnpm test src/packed-consumer.test.ts",
    "test:swift-lint": "swift test --package-path swift/SwiftLintChecks && SWIFT_LINT_TEST=1 pnpm test src/packed-consumer.test.ts"
  },
  "dependencies": {
    "@kamaal111/oxlint-plugin-anti-slop": "^0.0.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-import": "^2.32.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.88.0",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
