{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm run build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm run lint",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "pnpm run format",
      "problemMatcher": []
    },
    {
      "label": "format:check",
      "type": "shell",
      "command": "pnpm run format:check",
      "problemMatcher": []
    },
    {
      "label": "type-check",
      "type": "shell",
      "command": "pnpm run type-check",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "quality",
      "type": "shell",
      "command": "pnpm run quality",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
